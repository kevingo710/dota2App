{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-agent:latest",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {"baseURL": "http://localhost:11434/v1"},
      "models": {
        "qwen3-agent:latest": {"name": "Qwen3 8B agent (64k ctx)", "tool_call": true},
        "qwen3:8b": {"name": "Qwen3 8B", "tool_call": true},
        "gemma4-agent:latest": {"name": "Gemma 4 12B vision (32k ctx)", "tool_call": true, "attachment": true},
        "gpt-oss-agent:latest": {"name": "gpt-oss 20B MoE (32k ctx)", "tool_call": true, "reasoning": true},
        "qwen3-14b-agent:latest": {"name": "Qwen3 14B agent (32k ctx)", "tool_call": true}
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "deny",
      "npx tsc*": "allow",
      "npx eslint*": "allow",
      "npx jest*": "allow",
      "npx prettier*": "allow",
      "harness/gate.sh*": "allow",
      "python3 harness/check_architecture.py*": "allow",
      "scripts/telegram.sh*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "date*": "allow"
    }
  }
}
